<article id="<%= post.layout %>-<%= post.slug %>" class="h-entry article article-type-<%= post.layout %>" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <% if (index) { %>
    <div class="article-inner">
      <header class="article-header">
        <%- partial('post/title', {class_name: 'p-name article-title'}) %>
      </header>
      <% if (post.description) { %>
        <div class="article-entry article-summary" itemprop="description">
          <p><%= post.description %></p>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="article-meta" aria-label="Article metadata">
      <span class="meta-item"><strong>Date:</strong> <%= post.date.format('YYYY-MM-DD') %></span>
      <% if (post.categories && post.categories.length) { %>
        <span class="meta-item"><strong>Category:</strong> <%= post.categories.map(category => category.name).join(', ') %></span>
      <% } %>
      <% if (post.tags && post.tags.length) { %>
        <span class="meta-item"><strong>Tags:</strong> <%= post.tags.map(tag => tag.name).join(', ') %></span>
      <% } %>
    </div>
    <div class="article-inner">
      <%- partial('post/gallery') %>
      <header class="article-header">
        <%- partial('post/title', {class_name: 'p-name article-title'}) %>
      </header>
      <div class="e-content article-entry" itemprop="articleBody">
        <%- post.content %>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10.9.3/dist/mermaid.min.js" integrity="sha256-Wo7JGCC9Va/vBJBoSJNpkQ5dbOcMgQOVLyfinT526Lw=" crossorigin="anonymous"></script>
    <script>
      (function () {
        function renderMermaid() {
          if (!window.mermaid) return;
          var blocks = document.querySelectorAll('.article-entry pre code.language-mermaid, .article-entry figure.highlight td.code > pre');
          var diagrams = [];
          blocks.forEach(function (code) {
            var lines = code.querySelectorAll('.line');
            var source = lines.length
              ? Array.prototype.map.call(lines, function (line) { return line.textContent; }).join('\n').trim()
              : code.textContent.trim();
            if (!/^(flowchart|graph|sequenceDiagram)\b/.test(source)) return;
            var container = code.closest('figure') || code.parentElement;
            var diagram = document.createElement('div');
            diagram.className = 'mermaid';
            diagram.id = 'mermaid-diagram-' + diagrams.length;
            diagram.textContent = source;
            container.replaceWith(diagram);
            diagrams.push(diagram);
          });
          if (!diagrams.length) return;
          window.mermaid.initialize({ startOnLoad: false, securityLevel: 'strict' });
          window.mermaid.run({ nodes: diagrams });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', renderMermaid);
        } else {
          renderMermaid();
        }
      }());
    </script>
  <% } %>
</article>
